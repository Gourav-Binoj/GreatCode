# Copy to .env for local development.
# Every VITE_* value is inlined into the JS bundle at build time and
# is therefore PUBLIC. Never put a service-role key, a Gemini key, or
# any other backend secret in this file or in Vercel's frontend
# environment variables.

# FastAPI backend.
#   local      http://localhost:8000
#   production https://greatcode-tieo.onrender.com
VITE_API_URL=https://greatcode-tieo.onrender.com

# Supabase project URL and ANON key only.
# The anon key is meant to be public and is protected by row level
# security. The service-role key belongs on the backend only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

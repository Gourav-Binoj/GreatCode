# Backend secrets. NEVER commit the real .env, and never copy any of
# these into a VITE_* variable - anything VITE_* is inlined into the
# public JS bundle.
#
# In production these come from the Render dashboard, not a file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Extra CORS origins, comma separated (custom domain, Vercel preview).
# The production Vercel URL and localhost are already allowed in code.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# FEEDBACK EMAIL (optional)
# ---------------------------------------------------------------
# Leave blank to disable; feedback is still saved to the database,
# it just does not send a notification.
#
# For Gmail, SMTP_PASSWORD must be an APP PASSWORD, not your account
# password - Google rejects plain password SMTP. Create one at
# https://myaccount.google.com/apppasswords (needs 2FA enabled).
# It looks like "abcd efgh ijkl mnop"; spaces are fine.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gouravbinoj@gmail.com
SMTP_PASSWORD=

# Where notifications are sent. Defaults to SMTP_USER if blank.
FEEDBACK_EMAIL=gouravbinoj@gmail.com
